{
  "name": "storygro",
  "version": "0.2.0",
  "private": true,
  "description": "A toolkit for AI agents to turn ideas into reels, videos, carousels, and social posts. Build your audience and grow your brand through content.",
  "type": "module",
  "license": "PolyForm-Shield-1.0.0",
  "bin": {
    "storygro": "production/src/cli.ts"
  },
  "scripts": {
    "setup": "sh production/scripts/setup.sh",
    "setup:ru": "sh production/scripts/setup.sh ru",
    "storygro": "tsx production/src/cli.ts",
    "reel": "tsx production/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:media": "node production/scripts/check-git-media.mjs",
    "assets:fetch": "node production/scripts/fetch-assets.mjs",
    "hooks:install": "node production/scripts/install-hooks.mjs",
    "check": "npm run check:media && npm run typecheck && npm test"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiler2005/Storygro.git"
  },
  "keywords": [
    "ai-agents",
    "storytelling",
    "content-creation",
    "video-generation",
    "social-media",
    "content-marketing",
    "reels",
    "automation"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
